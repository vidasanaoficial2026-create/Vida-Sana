# ==============================================================================
# VIDA SANA (4M NATURE) — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# INSTRUCCIONES:
# Copiar este archivo a '.env' y configurar con los valores correspondientes.
# NUNCA comitear secretos reales al repositorio de control de versiones.
# ==============================================================================

# Entorno y Seguridad Flask
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_generar_con_openssl_rand_hex_32
FLASK_ENV=production
BASE_URL=http://localhost:5000

# Base de Datos PostgreSQL (Supabase / Pooler)
# Formato: postgresql://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://postgres.project_ref:password@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=tu_cliente_id_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secreto_google

# Servicio de Correo SMTP (Verificación y Recuperación OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion_google
